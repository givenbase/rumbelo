# ============================================================================
#           💰 RUMBELO BACKEND - ENVIRONMENT CONFIGURATION
# ============================================================================
# Template for `@rumbelo/backend` (NestJS + oRPC + Better Auth).
#
# Local development usually uses the monorepo root `.env`:
#   cp ../../.env.example ../../.env
#
# For Railway / isolated deploys, copy this file next to the service and fill
# values, or set the same keys in the Railway dashboard.
#
# ⚠️  SECURITY WARNING: Never commit a filled `.env` to version control!
# ============================================================================


# ============================================================================
# 🚀 1. APPLICATION CONFIGURATION
# ============================================================================

# Environment mode (development, test, production)
NODE_ENV=development

# API listen port (default: 3002)
PORT=3002


# ============================================================================
# 🌐 2. DOMAIN CONFIGURATION
# ============================================================================
# CORS + Better Auth trustedOrigins. Must include every browser origin that
# calls the API with credentials.

APP_URL=http://localhost:3000          # @rumbelo/application
WEB_URL=http://localhost:3001          # @rumbelo/website
API_URL=http://localhost:3002          # this service (docs / tooling)


# ============================================================================
# 🗄️  3. DATABASE CONFIGURATION
# ============================================================================

# --- PostgreSQL ---
# postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://rumbelo:rumbelo@localhost:5432/rumbelo

# String "true" / "false". Required true on Railway managed Postgres.
DATABASE_SSL=false

# --- Redis (optional locally) ---
REDIS_URL=redis://localhost:6379


# ============================================================================
# 🔐 4. AUTHENTICATION & SECURITY
# ============================================================================

# ≥ 32 characters. Signs every session cookie.
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Public base URL where /api/auth is reachable
BETTER_AUTH_URL=http://localhost:3002


# ============================================================================
# 🏦 5. BANK SYNC (optional — off by default)
# ============================================================================
# CSV import works without this. Live sync needs FEATURE_BANK_SYNC=true plus
# Enable Banking credentials (restricted production / owner-linked accounts).

FEATURE_BANK_SYNC=false
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=


# ============================================================================
# 🤖 6. AI / COACH (optional)
# ============================================================================

ANTHROPIC_API_KEY=


# ============================================================================
# 📈 7. MONITORING (optional)
# ============================================================================

SENTRY_DSN=


# ============================================================================
# 📝 ADDITIONAL NOTES
# ============================================================================
#
# 🚀 Local:
#   1. Prefer monorepo root `.env` (dotenv walk-up from main.ts / MikroORM)
#   2. pnpm infra:up && pnpm db:migrate && pnpm auth:migrate
#   3. pnpm --filter @rumbelo/backend dev
#
# ✅ Production:
#   ✓ NODE_ENV=production + DATABASE_SSL=true
#   ✓ Unique BETTER_AUTH_SECRET per environment
#   ✓ APP_URL / WEB_URL / BETTER_AUTH_URL on HTTPS public domains
#
# 📋 Validated by: apps/backend/src/common/config/env.config.ts
#
# ============================================================================
