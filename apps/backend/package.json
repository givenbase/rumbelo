{
  "name": "@rumbelo/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "lint": "eslint --max-warnings 0",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "NODE_OPTIONS='--import tsx/esm' mikro-orm migration:up",
    "db:create": "NODE_OPTIONS='--import tsx/esm' mikro-orm migration:create",
    "db:fresh": "NODE_OPTIONS='--import tsx/esm' mikro-orm schema:fresh --run --seed",
    "db:seed": "NODE_OPTIONS='--import tsx/esm' mikro-orm seeder:run",
    "auth:migrate": "NODE_OPTIONS='--import tsx/esm' tsx ./src/auth/auth.migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "^13.0.2",
    "@mikro-orm/core": "^6.6.3",
    "@mikro-orm/migrations": "^6.6.3",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.6.3",
    "@mikro-orm/reflection": "^6.6.3",
    "@mikro-orm/seeder": "^6.6.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@orpc/client": "1.13.0",
    "@orpc/contract": "1.13.0",
    "@orpc/nest": "1.13.0",
    "@orpc/server": "1.13.0",
    "@rumbelo/contracts": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.4.0",
    "better-auth": "^1.5.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "5.11.3",
    "ioredis": "^5.10.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.3",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@rumbelo/eslint-config": "workspace:*",
    "@rumbelo/typescript-config": "workspace:*",
    "@types/node": "26.3.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^17.4.1",
    "eslint": "10.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "mikro-orm": {
    "configPaths": [
      "./mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  },
  "type": "module"
}
