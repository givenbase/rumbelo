# =============================================================================
# GitHub Environment VARIABLES — template (no secrets)
# =============================================================================
# After init, edit these gitignored files (repo root):
#   .env.github.vars.staging
#   .env.github.vars.production
#
# Commands:
#   pnpm sync:github-secrets:init
#   pnpm sync:github-secrets
#
# Hint — .env.github.vars.staging:
#   DATABASE_SSL=true
#   DOMAIN_APP=https://…staging…
#   DOMAIN_WEB=https://…staging…
#   DOMAIN_BACK=https://…staging…          # public HTTPS for CI (not railway.internal)
#   DOMAIN_BACK_PUBLIC=https://…staging…   # preferred for api-smoke / e2e
#
# Hint — .env.github.vars.production:
#   same keys with production public HTTPS origins
#
# Backend NODE_ENV in GitHub Actions is always `production` (see resolve-deploy-environment).
# Do not set NODE_ENV=development here.
# =============================================================================

# ── REQUIRED — db-migrate.yml + api-smoke + e2e ──────────────────────────────
DOMAIN_APP=
DOMAIN_WEB=
DOMAIN_BACK=
DOMAIN_BACK_PUBLIC=
DATABASE_SSL=true

# ── Optional — Next public mirrors (if a workflow builds Next apps later) ────
# NEXT_PUBLIC_DOMAIN_APP=
# NEXT_PUBLIC_DOMAIN_WEB=
# NEXT_PUBLIC_DOMAIN_BACK=
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_PREVIEW_MODE=
# NEXT_PUBLIC_PREVIEW_PLAN=
