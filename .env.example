# ============================================================================
#           💰 RUMBELO - ENVIRONMENT CONFIGURATION
# ============================================================================
# This file is the monorepo template for local development. Copy it to `.env`
# at the repo root — the backend walks up to this file; Turbo also watches it.
#
#   cp .env.example .env
#
# Per-app Next.js templates (client-safe vars only):
#   apps/application/.env.example
#   apps/website/.env.example
# Backend-only reference (same keys as this file for Railway / isolated deploys):
#   apps/backend/.env.example
#
# ⚠️  SECURITY WARNING: Never commit the `.env` file to version control!
# ============================================================================


# ============================================================================
# 🚀 1. APPLICATION CONFIGURATION
# ============================================================================
# Core runtime settings for the NestJS API (`@rumbelo/backend`)

# Environment mode (development, test, production)
NODE_ENV=development

# API server port (default: 3002)
PORT=3002


# ============================================================================
# 🌐 2. DOMAIN CONFIGURATION
# ============================================================================
# Used for CORS, Better Auth trusted origins, and absolute links.
# Application (product) → 3000 | Website (marketing) → 3001 | Backend (API) → 3002

APP_URL=http://localhost:3000          # Authenticated product (@rumbelo/application)
WEB_URL=http://localhost:3001          # Marketing site (@rumbelo/website)
API_URL=http://localhost:3002          # Backend API (documentation / tooling)

# Public URLs baked into the Next.js apps (safe to expose — no secrets)
# Prefer setting these in apps/application/.env.local for Next; root values
# work when you load them via Turbo / docker compose.
NEXT_PUBLIC_API_URL=http://localhost:3002/rpc
NEXT_PUBLIC_AUTH_URL=http://localhost:3002/api/auth


# ============================================================================
# 🗄️  3. DATABASE CONFIGURATION
# ============================================================================

# --- PostgreSQL ---
# Connection URL: postgresql://[user]:[password]@[host]:[port]/[database]
# Local default matches `pnpm infra:up` (Docker Compose).
# Railway: paste the plugin connection string; keep region europe-west4 (Amsterdam).
DATABASE_URL=postgresql://rumbelo:rumbelo@localhost:5432/rumbelo

# Enable SSL for the database connection (required on Railway / managed Postgres)
# Must be the string "true" or "false" — bare true/false strings are parsed carefully
DATABASE_SSL=false

# --- Redis ---
# Session cache / job queue. Optional locally if unused; set for Railway.
REDIS_URL=redis://localhost:6379


# ============================================================================
# 🔐 4. AUTHENTICATION & SECURITY
# ============================================================================

# --- Better Auth ---
# Secret key for signing session cookies and tokens (REQUIRED, ≥ 32 characters)
# Generate a secure random string:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-characters

# Public base URL of the auth endpoints (must match where the API is reachable)
BETTER_AUTH_URL=http://localhost:3002

# Auth HTTP path is fixed in code to /api/auth (see apps/backend/src/auth)


# ============================================================================
# 🏦 5. BANK SYNC (optional — off by default)
# ============================================================================
# CSV import always works without these. Live bank sync stays dark until you
# flip the feature flag and supply aggregator credentials.
#
# Context: the old free self-serve tier (GoCardless Bank Account Data / Nordigen)
# closed to new signups. Enable Banking has a free "restricted production" tier
# limited to accounts you link yourself — fits the owner-plus-friends phase.
#
# Docs: https://enablebanking.com/

FEATURE_BANK_SYNC=false
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=


# ============================================================================
# 🤖 6. AI / COACH (optional)
# ============================================================================
# Used by coach / advisory features when wired. Leave empty to keep coach offline.

ANTHROPIC_API_KEY=


# ============================================================================
# 📈 7. MONITORING & ERROR TRACKING (optional)
# ============================================================================

# --- Sentry ---
# Create a dedicated backend project in Sentry. Leave empty to disable.
SENTRY_DSN=


# ============================================================================
# 📝 ADDITIONAL NOTES
# ============================================================================
#
# 🚀 Development Setup:
#   1. Copy this file to `.env` at the monorepo root
#   2. Set BETTER_AUTH_SECRET (openssl rand -base64 32)
#   3. pnpm install && pnpm infra:up && pnpm db:migrate && pnpm auth:migrate
#   4. pnpm dev  → application :3000 | website :3001 | backend :3002
#   5. Optional: copy apps/application/.env.example → apps/application/.env.local
#
# ✅ Production Checklist (Railway EU / europe-west4):
#   ✓ NODE_ENV=production
#   ✓ DATABASE_SSL=true
#   ✓ Strong unique BETTER_AUTH_SECRET (never reuse across environments)
#   ✓ APP_URL / WEB_URL / BETTER_AUTH_URL point at public HTTPS domains
#   ✓ NEXT_PUBLIC_API_URL / NEXT_PUBLIC_AUTH_URL match the public API
#   ✓ FEATURE_BANK_SYNC=false until aggregator credentials are ready
#   ✓ Configure SENTRY_DSN when you want error tracking
#
# 🔒 Security Best Practices:
#   - Never commit `.env` or `.env.local` to version control
#   - NEXT_PUBLIC_* values are exposed to the browser — never put secrets there
#   - Rotate BETTER_AUTH_SECRET if it ever leaks (invalidates all sessions)
#   - Prefer Railway / secret managers over baking secrets into images
#
# 📋 Validation:
#   - Backend vars are validated on boot by apps/backend/src/common/config/env.config.ts
#   - A finance API with a half-configured env refuses to start (fail fast)
#
# ============================================================================
