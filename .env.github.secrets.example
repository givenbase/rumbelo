# =============================================================================
# GitHub Environment SECRETS — template (no real values)
# =============================================================================
# After init, edit these gitignored files (repo root):
#   .env.github.secrets.staging
#   .env.github.secrets.production
#
# Commands:
#   pnpm sync:github-secrets:init
#   pnpm sync:github-secrets
#
# GitHub Environments (exact names): staging | production
# Local development uses repo-root `.env` — not GitHub.
# GITHUB_TOKEN is injected by Actions — do not add here.
#
# Match: apps/backend/.env.example, root .env.example, .github/workflows/README.md
# =============================================================================

# ── REQUIRED — db-migrate.yml ────────────────────────────────────────────────
DATABASE_URL=
BETTER_AUTH_SECRET=

# ── Optional — Redis (if migrate / runtime needs it in CI) ───────────────────
# DATABASE_REDIS_URL=

# ── Optional — email / payments / monitoring ─────────────────────────────────
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SIGNING_SECRET=
# SENTRY_DSN=
# OPENAI_API_KEY=
# ENABLE_BANKING_PRIVATE_KEY=

# ── Optional — E2E credentials (e2e-smoke.yml; defaults = seed demos) ────────
# E2E_BASIC_EMAIL=
# E2E_BASIC_PASSWORD=
# E2E_PLUS_EMAIL=
# E2E_PLUS_PASSWORD=
# E2E_MAX_EMAIL=
# E2E_MAX_PASSWORD=
