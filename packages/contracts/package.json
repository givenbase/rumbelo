{
    "name": "@rumbelo/contracts",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./src/index.ts",
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./src/index.ts"
        },
        "./react": {
            "types": "./src/client/react.tsx",
            "import": "./src/client/react.tsx",
            "require": "./dist/react.cjs",
            "default": "./src/client/react.tsx"
        },
        "./money": {
            "types": "./src/money/index.ts",
            "import": "./dist/money.js",
            "require": "./dist/money.cjs",
            "default": "./src/money/index.ts"
        },
        "./growth": {
            "types": "./src/growth/index.ts",
            "import": "./dist/growth.js",
            "require": "./dist/growth.cjs",
            "default": "./src/growth/index.ts"
        },
        "./platform": {
            "types": "./src/platform/index.ts",
            "import": "./dist/platform.js",
            "require": "./dist/platform.cjs",
            "default": "./src/platform/index.ts"
        },
        "./energy": {
            "types": "./src/energy/index.ts",
            "import": "./dist/energy.js",
            "require": "./dist/energy.cjs",
            "default": "./src/energy/index.ts"
        },
        "./soul": {
            "types": "./src/soul/index.ts",
            "import": "./dist/soul.js",
            "require": "./dist/soul.cjs",
            "default": "./src/soul/index.ts"
        },
        "./backoffice": {
            "types": "./src/backoffice/index.ts",
            "import": "./dist/backoffice.js",
            "require": "./dist/backoffice.cjs",
            "default": "./src/backoffice/index.ts"
        },
        "./common": {
            "types": "./src/common/index.ts",
            "import": "./dist/common.js",
            "require": "./dist/common.cjs",
            "default": "./src/common/index.ts"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "scripts": {
        "build": "tsup && node scripts/add-use-client.mjs",
        "dev": "tsup --watch --onSuccess \"node scripts/add-use-client.mjs\"",
        "check-types": "tsc --noEmit",
        "clean": "rm -rf dist .turbo"
    },
    "dependencies": {
        "@orpc/client": "^1.13.0",
        "@orpc/contract": "^1.13.0",
        "@orpc/openapi-client": "1.13.0",
        "@orpc/server": "^1.13.0",
        "@orpc/tanstack-query": "^1.13.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@rumbelo/typescript-config": "workspace:*",
        "@tanstack/react-query": "^5.90.12",
        "@types/react": "19.2.18",
        "tsup": "^8.5.0",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "@tanstack/react-query": "^5",
        "react": "^19"
    },
    "peerDependenciesMeta": {
        "@tanstack/react-query": {
            "optional": true
        },
        "react": {
            "optional": true
        }
    }
}
