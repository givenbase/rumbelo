{
    "name": "@rumbelo/i18n",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "main": "./src/index.ts",
    "types": "./src/index.ts",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "default": "./src/index.ts"
        },
        "./translations": {
            "types": "./translations/index.ts",
            "default": "./translations/index.ts"
        },
        "./translations/*": {
            "types": "./translations/*.ts",
            "default": "./translations/*.ts"
        },
        "./languages/*": "./languages/*"
    },
    "scripts": {
        "generate": "tsx ./src/generate-languages.ts",
        "check-types": "tsc --pretty --noEmit",
        "clean": "rm -rf .turbo dist"
    },
    "dependencies": {
        "next-intl": "^4.6.1"
    },
    "devDependencies": {
        "@rumbelo/typescript-config": "workspace:*",
        "tsx": "^4.20.5",
        "typescript": "5.9.3"
    },
    "peerDependencies": {
        "next": ">=15",
        "react": "^19"
    }
}
