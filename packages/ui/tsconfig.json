{
    "extends": "@rumtelo/typescript-config/react-library.json",
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "rootDir": "src",
        "outDir": "dist",
        "strictNullChecks": true,
        "paths": {
            "@rumtelo/ui/*": ["./src/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
